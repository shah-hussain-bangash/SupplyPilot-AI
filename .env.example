# Local reference only. Do not commit real secrets or expose the local server publicly.
APP_MODE=local
AUTH_MODE=local
DATA_DIR=./data
# Choose a unique secret and seed password locally; no deployed credentials are shipped.
TOKEN_SECRET=
DEMO_PASSWORD=
# DATABASE_URL=postgresql+psycopg://supplypilot:YOUR_PASSWORD@localhost:5432/supplypilot
REDIS_URL=redis://localhost:6379/0
# Non-local mode requires registered subject IDs in users and these OIDC values.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
# Optional private gateway contract: docs/MODEL_GATEWAY.md. Disabled by default.
ENABLE_MODEL_EGRESS=false
MODEL_GATEWAY_URL=
MODEL_GATEWAY_TOKEN=
